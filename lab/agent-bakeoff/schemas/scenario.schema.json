{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://granaide.local/lab/agent-bakeoff/schemas/scenario.schema.json",
  "title": "LAB-00 candidate-neutral scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "objective",
    "candidatePrompt",
    "allowedEvidenceRoots",
    "forbiddenAssumptions",
    "expectedEvidenceIds",
    "expectedTruthFacts",
    "hardFailConditions",
    "deterministicChecks",
    "humanReviewRubric"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^T[1-7]$" },
    "title": { "type": "string" },
    "objective": { "type": "string" },
    "candidatePrompt": { "type": "string" },
    "allowedEvidenceRoots": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "forbiddenAssumptions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "expectedEvidenceIds": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "expectedTruthFacts": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "hardFailConditions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "deterministicChecks": {
      "type": "object",
      "required": [
        "requiredEvidenceIds",
        "forbiddenEvidenceIds",
        "staleFactsMustNotBeCurrent",
        "forbiddenMutationPaths"
      ],
      "properties": {
        "requiredEvidenceIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "forbiddenEvidenceIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "staleFactsMustNotBeCurrent": {
          "type": "array",
          "items": { "type": "string" }
        },
        "currentFacts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "forbiddenMutationPaths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requiredMutationPaths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requiredToolClasses": {
          "type": "array",
          "items": { "type": "string" }
        },
        "forbiddenToolClasses": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "humanReviewRubric": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dimension", "question"],
        "properties": {
          "dimension": { "type": "string" },
          "question": { "type": "string" },
          "autoGraded": { "type": "boolean" }
        }
      }
    }
  }
}
