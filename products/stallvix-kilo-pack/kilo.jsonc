{
  "$schema": "https://app.kilo.ai/config.json",
  // Granaide StallVix Kilo Executor Pack v0 (CURSOR-01D grep hard-deny; DS-01 policy/runtime-root hardening; DS-02 supply-chain/write-tool fail-closed)
  // Install into StallVix checkout per INSTALL.md — do not commit secrets.
  // Permission rule order: last matching rule wins (Kilo Agent Permissions docs).
  // Put catch-all first; specific allow/deny exceptions after.
  // Tool boundaries are distinct: read ≠ grep ≠ glob ≠ external_directory ≠ bash ≠ edit.
  // DS-02/S2A: write and apply_patch are separate Edit-group tools (Kilo "How Tools Work").
  // Public docs do not prove they inherit the `edit` path map. Fail-closed: identical
  // deny maps on implementer; deny on investigator. Runtime must still prove binding
  // (ask is not an authority/evidence boundary). Gate C/D — no authenticated run here.
  // KILO-01R: grep path denies match the search ROOT only, not each hit file — parent-dir
  // grep bypassed **/credentials.json. Investigator therefore hard-denies grep entirely.
  // DS-01/F3: .kilo-runtime-data/** is worktree-local Kilo runtime state; agents cannot read it.
  // DS-01/F2: no unconditional src/** or docs/** edit allow; authority/evidence paths hard-deny.
  // DS-02/S1: no Context7 MCP and no unpinned npx runtime-executable in candidate v0.1.
  "default_agent": "stallvix-investigator",
  "permission": {
    "read": {
      "*": "allow",
      ".kilo-runtime-data/**": "deny",
      ".env": "deny",
      "*/.env": "deny",
      ".env.*": "deny",
      "*/.env.*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "credentials.json": "deny",
      "*/credentials.json": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      ".env.example": "allow",
      "*/.env.example": "allow"
    },
    "edit": "ask",
    "write": "ask",
    "apply_patch": "ask",
    "bash": "ask",
    "external_directory": "ask",
    "glob": {
      "*": "allow",
      ".kilo-runtime-data/**": "deny"
    }
  },
  "agent": {
    "stallvix-investigator": {
      "description": "DEFAULT safe agent. Read-only StallVix investigator for audits and Test A. No edits, no shell, no grep, no outside-worktree access.",
      "mode": "primary",
      "color": "#64748B",
      "prompt": "You are the Granaide StallVix investigator — read-only Level-C style inspection without mutation.\n\nYou may read repository files (except denied sensitive paths), summarize architecture, cite SPEC/AGENTS/CURRENT_STATE, and draft a Work Receipt for findings. Prefer targeted `read` of known paths over search.\n\nYou must NOT:\n- edit or create files (except the operator may save your receipt outside the session)\n- run shell commands\n- use grep/search tools (hard-denied — Kilo grep permissions apply to search root, not hit files)\n- access paths outside the worktree\n- request or use secrets / service-role keys\n- claim implementation authority from observatory research (including StallVix PR #35)\n\nOutput: sourced findings + a receipt draft matching the stallvix-receipt skill. Prefer uncertainty over invention.",
      "permission": {
        "read": {
          "*": "allow",
          ".kilo-runtime-data/**": "deny",
          ".env": "deny",
          "*/.env": "deny",
          ".env.*": "deny",
          "*/.env.*": "deny",
          "*.env": "deny",
          "*.env.*": "deny",
          "credentials.json": "deny",
          "*/credentials.json": "deny",
          "*.pem": "deny",
          "*.key": "deny",
          ".env.example": "allow",
          "*/.env.example": "allow"
        },
        // CURSOR-01D / KILO-01R: path-scoped grep denies are not content-safe when the
        // search root is a parent directory. Hard-deny the tool for investigator.
        "grep": "deny",
        // Glob may still reveal filenames; that is name discovery, not content confidentiality.
        // DS-01/F3: runtime root names are not discoverable either.
        "glob": {
          "*": "allow",
          ".kilo-runtime-data/**": "deny"
        },
        "edit": "deny",
        "write": "deny",
        "apply_patch": "deny",
        "bash": "deny",
        "external_directory": "deny",
        "task": "deny"
      }
    },
    "stallvix-implementer": {
      "description": "Constrained Level-C StallVix implementer. Obeys SPEC/SCOPE/AGENTS. No migrations, auth, deploy, or main. Select deliberately — not the default.",
      "mode": "primary",
      "color": "#0F766E",
      "prompt": "You are the Granaide StallVix implementer — a replaceable Level-C executor, not StallVix's brain.\n\nAuthority order (read before acting):\n1. SPEC.md — durable product truth\n2. SCOPE.md — what is authorized NOW (if present)\n3. BACKLOG.md — candidates only, not authorization\n4. AGENTS.md (repo + this pack) — how workers behave\n\nHard rules:\n- One modifying owner at a time. Inspect before edit.\n- Never apply migrations, change auth/RLS, edit wrangler.toml, deploy, or push to main.\n- Never use or request Supabase service-role keys.\n- Prefer smallest complete change. No unrelated cleanup.\n- After material work, emit a Work Receipt using the stallvix-receipt skill.\n- If scope is unclear or blocked twice on the same issue, STOP and escalate to the owner.\n- Do not fetch live library docs via MCP in candidate v0.1. Use the job packet and in-repo sources.\n\nAllowed edit focus: only the exact paths granted by the job packet — there is no unconditional src/** or docs/** write allow in the base policy. Authority/evidence (SPEC.md, SCOPE.md, BACKLOG.md, AGENTS.md, CLAUDE.md, AGENTS.granaide-kilo.md, docs/agent-work/packets/**, docs/audit/**), .kilo/**, .kilo-runtime-data/**, supabase/migrations/**, wrangler.toml, .env*, and credentials/pem/key files are hard-denied.\nVerification: npm run typecheck, npm run lint, npm test as appropriate — do not invent deploy proof. Those three npm scripts are StallVix consumer commands, not Granaide source scripts.",
      "permission": {
        "read": {
          "*": "allow",
          ".kilo-runtime-data/**": "deny",
          ".env": "deny",
          "*/.env": "deny",
          ".env.*": "deny",
          "*/.env.*": "deny",
          "*.env": "deny",
          "*.env.*": "deny",
          "credentials.json": "deny",
          "*/credentials.json": "deny",
          "*.pem": "deny",
          "*.key": "deny",
          ".env.example": "allow",
          "*/.env.example": "allow"
        },
        // Kilo authorizes grep against the search root, not each hit. A parent-root
        // search can therefore disclose denied descendants, so this pack denies grep.
        "grep": "deny",
        // Glob reveals names only; the worktree runtime root stays opaque (DS-01/F3).
        "glob": {
          "*": "allow",
          ".kilo-runtime-data/**": "deny"
        },
        // Last matching rule wins. Catch-all ask first; NO unconditional src/docs
        // allow; authority/evidence/runtime-data/migrations/env/wrangler deny last.
        // A job-specific agent or generated job grant adds exact `allow` paths.
        // DS-02/S2A: keep edit / write / apply_patch maps identical until runtime
        // proves inheritance. Do not treat ask as a deny.
        "edit": {
          "*": "ask",
          "SPEC.md": "deny",
          "SCOPE.md": "deny",
          "BACKLOG.md": "deny",
          "AGENTS.md": "deny",
          "CLAUDE.md": "deny",
          "AGENTS.granaide-kilo.md": "deny",
          "docs/agent-work/packets/**": "deny",
          "docs/audit/**": "deny",
          ".kilo/**": "deny",
          ".kilo-runtime-data/**": "deny",
          "supabase/migrations/**": "deny",
          "supabase/functions/**": "ask",
          "wrangler.toml": "deny",
          ".env": "deny",
          "*/.env": "deny",
          ".env.*": "deny",
          "*/.env.*": "deny",
          "*.env": "deny",
          "*.env.*": "deny",
          "credentials.json": "deny",
          "*/credentials.json": "deny",
          "*.pem": "deny",
          "*.key": "deny"
        },
        "write": {
          "*": "ask",
          "SPEC.md": "deny",
          "SCOPE.md": "deny",
          "BACKLOG.md": "deny",
          "AGENTS.md": "deny",
          "CLAUDE.md": "deny",
          "AGENTS.granaide-kilo.md": "deny",
          "docs/agent-work/packets/**": "deny",
          "docs/audit/**": "deny",
          ".kilo/**": "deny",
          ".kilo-runtime-data/**": "deny",
          "supabase/migrations/**": "deny",
          "supabase/functions/**": "ask",
          "wrangler.toml": "deny",
          ".env": "deny",
          "*/.env": "deny",
          ".env.*": "deny",
          "*/.env.*": "deny",
          "*.env": "deny",
          "*.env.*": "deny",
          "credentials.json": "deny",
          "*/credentials.json": "deny",
          "*.pem": "deny",
          "*.key": "deny"
        },
        "apply_patch": {
          "*": "ask",
          "SPEC.md": "deny",
          "SCOPE.md": "deny",
          "BACKLOG.md": "deny",
          "AGENTS.md": "deny",
          "CLAUDE.md": "deny",
          "AGENTS.granaide-kilo.md": "deny",
          "docs/agent-work/packets/**": "deny",
          "docs/audit/**": "deny",
          ".kilo/**": "deny",
          ".kilo-runtime-data/**": "deny",
          "supabase/migrations/**": "deny",
          "supabase/functions/**": "ask",
          "wrangler.toml": "deny",
          ".env": "deny",
          "*/.env": "deny",
          ".env.*": "deny",
          "*/.env.*": "deny",
          "*.env": "deny",
          "*.env.*": "deny",
          "credentials.json": "deny",
          "*/credentials.json": "deny",
          "*.pem": "deny",
          "*.key": "deny"
        },
        // Default-deny shell. Only exact, human-approved StallVix *consumer*
        // verification commands are exposed. Do not add Granaide-only scripts
        // here, and do not invent typecheck/test scripts in this repo's
        // package.json merely to resemble the consumer contract.
        "bash": {
          "*": "deny",
          "npm run typecheck": "ask",
          "npm run lint": "ask",
          "npm test": "ask",
          "git status --short": "ask",
          "git diff --check": "ask"
        },
        "external_directory": "deny",
        "task": "deny"
      }
    }
  }
}
