{
  "$schema": "https://app.kilo.ai/config.json",
  // Granaide StallVix Kilo Executor Pack v0 (CURSOR-01D grep hard-deny)
  // Install into StallVix checkout per INSTALL.md — do not commit secrets.
  // Permission rule order: last matching rule wins (Kilo Agent Permissions docs).
  // Put catch-all first; specific allow/deny exceptions after.
  // Tool boundaries are distinct: read ≠ grep ≠ glob ≠ external_directory ≠ bash ≠ edit.
  // KILO-01R: grep path denies match the search ROOT only, not each hit file — parent-dir
  // grep bypassed **/credentials.json. Investigator therefore hard-denies grep entirely.
  "default_agent": "stallvix-investigator",
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "environment": {
        "DEFAULT_MINIMUM_TOKENS": "5000"
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      "*/.env": "deny",
      ".env.*": "deny",
      "*/.env.*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "credentials.json": "deny",
      "*/credentials.json": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      ".env.example": "allow",
      "*/.env.example": "allow"
    },
    "edit": "ask",
    "bash": "ask",
    "external_directory": "ask"
  },
  "agent": {
    "stallvix-investigator": {
      "description": "DEFAULT safe agent. Read-only StallVix investigator for audits and Test A. No edits, no shell, no grep, no outside-worktree access.",
      "mode": "primary",
      "color": "#64748B",
      "prompt": "You are the Granaide StallVix investigator — read-only Level-C style inspection without mutation.\n\nYou may read repository files (except denied sensitive paths), summarize architecture, cite SPEC/AGENTS/CURRENT_STATE, and draft a Work Receipt for findings. Prefer targeted `read` of known paths over search.\n\nYou must NOT:\n- edit or create files (except the operator may save your receipt outside the session)\n- run shell commands\n- use grep/search tools (hard-denied — Kilo grep permissions apply to search root, not hit files)\n- access paths outside the worktree\n- request or use secrets / service-role keys\n- claim implementation authority from observatory research (including StallVix PR #35)\n\nOutput: sourced findings + a receipt draft matching the stallvix-receipt skill. Prefer uncertainty over invention.",
      "permission": {
        "read": {
          "*": "allow",
          ".env": "deny",
          "*/.env": "deny",
          ".env.*": "deny",
          "*/.env.*": "deny",
          "*.env": "deny",
          "*.env.*": "deny",
          "credentials.json": "deny",
          "*/credentials.json": "deny",
          "*.pem": "deny",
          "*.key": "deny",
          ".env.example": "allow",
          "*/.env.example": "allow"
        },
        // CURSOR-01D / KILO-01R: path-scoped grep denies are not content-safe when the
        // search root is a parent directory. Hard-deny the tool for investigator.
        "grep": "deny",
        // Glob may still reveal filenames; that is name discovery, not content confidentiality.
        "edit": "deny",
        "bash": "deny",
        "external_directory": "deny",
        "task": "deny"
      }
    },
    "stallvix-implementer": {
      "description": "Constrained Level-C StallVix implementer. Obeys SPEC/SCOPE/AGENTS. No migrations, auth, deploy, or main. Select deliberately — not the default.",
      "mode": "primary",
      "color": "#0F766E",
      "prompt": "You are the Granaide StallVix implementer — a replaceable Level-C executor, not StallVix's brain.\n\nAuthority order (read before acting):\n1. SPEC.md — durable product truth\n2. SCOPE.md — what is authorized NOW (if present)\n3. BACKLOG.md — candidates only, not authorization\n4. AGENTS.md (repo + this pack) — how workers behave\n\nHard rules:\n- One modifying owner at a time. Inspect before edit.\n- Never apply migrations, change auth/RLS, edit wrangler.toml, deploy, or push to main.\n- Never use or request Supabase service-role keys.\n- Prefer smallest complete change. No unrelated cleanup.\n- After material work, emit a Work Receipt using the stallvix-receipt skill.\n- If scope is unclear or blocked twice on the same issue, STOP and escalate to the owner.\n- Use Context7 MCP for current library docs (Vite, React, Supabase client, Kilo) instead of guessing APIs.\n\nAllowed edit focus: src/** and docs/** unless the job packet narrows further.\nVerification: npm run typecheck, npm run lint, npm test as appropriate — do not invent deploy proof.",
      "permission": {
        "read": {
          "*": "allow",
          ".env": "deny",
          "*/.env": "deny",
          ".env.*": "deny",
          "*/.env.*": "deny",
          "*.env": "deny",
          "*.env.*": "deny",
          "credentials.json": "deny",
          "*/credentials.json": "deny",
          "*.pem": "deny",
          "*.key": "deny",
          ".env.example": "allow",
          "*/.env.example": "allow"
        },
        // Kilo authorizes grep against the search root, not each hit. A parent-root
        // search can therefore disclose denied descendants, so this pack denies grep.
        "grep": "deny",
        // Last matching rule wins. Catch-all first; path allows next; hard-denies last.
        "edit": {
          "*": "ask",
          "src/**": "allow",
          "docs/**": "allow",
          "observatory-suggestions/**": "ask",
          "supabase/functions/**": "ask",
          "supabase/migrations/**": "deny",
          "wrangler.toml": "deny",
          ".env": "deny",
          "*/.env": "deny",
          ".env.*": "deny",
          "*/.env.*": "deny",
          "credentials.json": "deny",
          "*/credentials.json": "deny",
          "*.pem": "deny",
          "*.key": "deny"
        },
        // Default-deny shell. Only exact, human-approved verification commands are exposed.
        // This avoids relying on bypassable deploy/push command blacklists.
        "bash": {
          "*": "deny",
          "npm run typecheck": "ask",
          "npm run lint": "ask",
          "npm test": "ask",
          "git status --short": "ask",
          "git diff --check": "ask"
        },
        "external_directory": "deny",
        "task": "deny"
      }
    }
  }
}
